  </footer>
</div>
<script>
  const statuses = ["Connecting...","Connected", "Online", "Satellite Connection"];
  let index = 0;
  const statusTextEl = document.getElementById("statusText");
  const containerEl = document.getElementById("statusContainer");

  function showStatus(status) {
    statusTextEl.classList.remove("show");
    // remove online class
    containerEl.classList.remove("status-online");
    setTimeout(() => {
      statusTextEl.textContent = status;
      if (status.toLowerCase().includes("online")) {
        containerEl.classList.add("status-online");
      }
      statusTextEl.classList.add("show");
    }, 500);
  }

  function cycleStatuses() {
    showStatus(statuses[index]);
    index = (index + 1) % statuses.length;
  }

  // Start
  cycleStatuses();
  setInterval(cycleStatuses, 4000);  // change every 4 seconds
</script>



<script>
  // fill year
  document.getElementById('year').textContent = new Date().getFullYear();

  // typing effect for terminal box
  const lines = [
    "booting... ok",
    "loading modules: core, net, ui",
    "ssh-key: loaded",
    "welcome, root@you. type 'help' to begin"
  ];
  const el = document.getElementById('typedLine');
  let line = 0, pos = 0;

  function typeStep(){
    if(line >= lines.length) return;
    const txt = lines[line];
    if(pos <= txt.length){
      el.textContent = txt.slice(0,pos);
      pos++;
      setTimeout(typeStep, 40 + Math.random()*50);
    } else {
      // pause, then next line appears on new row
      line++;
      pos = 0;
      if(line < lines.length){
        el.textContent += "\n";
        setTimeout(typeStep, 600);
      }
    }
  }
  // Start typing once visible
  typeStep();

  // basic nav highlight on click + keyboard friendly
  document.querySelectorAll('nav a').forEach(a=>{
    a.addEventListener('click', (e)=>{
      document.querySelectorAll('nav a').forEach(n=>n.classList.remove('active'));
      e.currentTarget.classList.add('active');
    });
  });

  // contact form handler (opens mailto as fallback)
  function handleForm(e){
    e.preventDefault();
    const name = encodeURIComponent(document.getElementById('name').value);
    const email = encodeURIComponent(document.getElementById('email').value);
    const msg = encodeURIComponent(document.getElementById('message').value);
    // try to open mail client
    const subject = encodeURIComponent(`Portfolio message from ${name}`);
    const body = encodeURIComponent(`from: ${name} <${email}>\n\n${decodeURIComponent(msg)}`);
    const mailto = `mailto:you@example.com?subject=${subject}&body=${body}`;
    window.location.href = mailto;
  }

  // keyboard accessibility: Enter/Space on project cards triggers outline focus
  document.querySelectorAll('.card-project').forEach(card=>{
    card.addEventListener('keydown', (e)=>{
      if(e.key === 'Enter' || e.key === ' '){
        e.currentTarget.style.boxShadow = "inset 0 0 20px rgba(51,255,122,0.03)";
        setTimeout(()=> e.currentTarget.style.boxShadow = "", 400);
      }
    });
  });
</script>
