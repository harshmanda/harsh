<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>root@you — Hacker Portfolio</title>
<link rel="icon" href="data:;base64,iVBORw0KGgo=">
<style>
  :root{
    --bg-url: url('bg.jpg'); /* <-- change to a URL or local file name (e.g. 'bg.jpg') */
    --bg-color: #020202;
    --panel: rgba(4,12,6,0.6);
    --green: #33ff7a;
    --muted: #6feeb0;
    --glass: rgba(255,255,255,0.02);
    --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, "Courier New", monospace;
  }

  /* Page base */
  html,body{height:100%;margin:0;background:var(--bg-color);font-family:var(--mono);color:var(--green);-webkit-font-smoothing:antialiased;}
  .wrap{
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:stretch;
    background-image:
      linear-gradient(180deg, rgba(0,0,0,0.55), rgba(0,0,0,0.65)),
      var(--bg-url);
    background-size:cover;
    background-position:center;
    background-attachment: fixed;
  }

  /* subtle noise overlay */
  .wrap::after{
    content:"";
    position:fixed;inset:0;pointer-events:none;
    background-image: linear-gradient(transparent 92%, rgba(0,0,0,0.05) 100%);
    mix-blend-mode:overlay;
    opacity:0.6;
  }

  header.navbar{
    display:flex;align-items:center;padding:14px 20px;gap:16px;
    background: linear-gradient(90deg, rgba(0,0,0,0.2), rgba(0,0,0,0.15));
    border-bottom:1px solid rgba(51,255,122,0.05);
    backdrop-filter: blur(6px);
  }
  .brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--green);font-weight:700;font-size:16px}
  .brand .dot{width:12px;height:12px;border-radius:3px;background:var(--green);box-shadow:0 0 12px rgba(51,255,122,0.2)}
  nav ul{display:flex;gap:8px;list-style:none;margin:0;padding:0}
  nav a{color:var(--green);text-decoration:none;padding:8px 10px;border-radius:6px;font-size:14px;border:1px solid rgba(51,255,122,0.03)}
  nav a:focus, nav a:hover{background:rgba(51,255,122,0.03);outline:none;box-shadow:0 6px 18px rgba(51,255,122,0.03)}
  nav a.active{background: rgba(51,255,122,0.05);box-shadow:inset 0 0 20px rgba(51,255,122,0.02)}

  /* hero */
  .hero{display:flex;gap:30px;padding:48px 20px;align-items:center;max-width:1100px;margin:0 auto;width:100%}
  .hero-left{flex:1;min-width:260px}
  .title{font-size:28px;margin:0 0 8px 0;color:#eafff0}
  .handle{font-size:13px;color:var(--muted);margin-bottom:14px}
  .terminal{
    background: linear-gradient(180deg, rgba(0,0,0,0.55), rgba(0,0,0,0.45));
    border:1px solid rgba(51,255,122,0.04);
    padding:18px;border-radius:10px;color:var(--green);
    box-shadow: 0 10px 40px rgba(0,0,0,0.6);
    font-size:13px;
  }
  .typed-cursor{display:inline-block;width:10px;height:18px;background:var(--green);margin-left:8px;vertical-align:middle;animation:blink 1s steps(1) infinite;border-radius:2px}
  @keyframes blink{50%{opacity:0}}

  /* quick links */
  .quicklinks{display:flex;gap:10px;margin-top:12px}
  .btn{background:transparent;border:1px solid rgba(51,255,122,0.06);padding:8px 12px;border-radius:8px;color:var(--green);text-decoration:none;font-size:13px}
  .btn:hover{background:rgba(51,255,122,0.03)}

  /* hero right - profile card */
  .hero-right{width:260px;min-width:220px}
  .card{
    background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
    border-radius:10px;padding:12px;border:1px solid rgba(255,255,255,0.03);
  }
  .avatar{
    width:100%;height:160px;border-radius:8px;background:linear-gradient(90deg,#052a12,#032318);
    display:flex;align-items:center;justify-content:center;font-size:48px;color:rgba(255,255,255,0.06);
    margin-bottom:12px;position:relative;overflow:hidden;border:1px solid rgba(51,255,122,0.03)
  }
  .status{font-size:13px;color:var(--muted);display:flex;justify-content:space-between;gap:8px}
  .chips{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
  .chip{background:rgba(51,255,122,0.03);padding:6px 8px;border-radius:6px;font-size:12px}

  /* main sections */
  main {max-width:1100px;margin:28px auto;padding:0 20px 80px 20px;width:100%;}
  section{margin-bottom:28px}
  h2{color:#dfffe7;margin:4px 0 12px 0;font-size:18px}
  .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
  .card-project{
    background:linear-gradient(180deg, rgba(0,0,0,0.46), rgba(0,0,0,0.36));
    border:1px solid rgba(51,255,122,0.04);
    padding:12px;border-radius:10px;
  }
  .proj-title{font-weight:700;color:#eafff0;margin:0 0 8px 0}
  .proj-desc{font-size:13px;color:var(--muted);margin:0 0 8px 0}
  .proj-tags{display:flex;gap:6px;flex-wrap:wrap}
  .tag{font-size:12px;padding:4px 8px;border-radius:6px;background:rgba(51,255,122,0.03)}

  /* contact */
  form input, form textarea{
    width:100%;background:transparent;border:1px solid rgba(51,255,122,0.05);padding:10px;border-radius:8px;color:var(--green);
    font-family:var(--mono);font-size:13px;resize:vertical;
  }
  form label{display:block;margin-bottom:6px;color:var(--muted);font-size:13px}
  .send{display:inline-block;padding:10px 14px;border-radius:8px;border:1px solid rgba(51,255,122,0.06);background:transparent;color:var(--green)}

  /* footer */
  footer{padding:18px 20px;color:var(--muted);font-size:13px;text-align:center}

  /* responsive */
  @media (max-width:880px){
    .grid{grid-template-columns:1fr}
    .hero{flex-direction:column;align-items:stretch;padding:28px 16px}
    .hero-right{width:auto}
  }
</style>
</head>
<body>
<div class="wrap" id="top">
  <header class="navbar" role="banner">
    <a class="brand" href="#top" aria-label="Home">
      <div class="dot" aria-hidden="true"></div>
      <div>root@you</div>
    </a>
    <nav aria-label="Primary navigation" style="margin-left:18px">
      <ul role="menubar">
        <li role="none"><a role="menuitem" class="active" href="#home">home</a></li>
        <li role="none"><a role="menuitem" href="#projects">projects</a></li>
        <li role="none"><a role="menuitem" href="#about">about</a></li>
        <li role="none"><a role="menuitem" href="#contact">contact</a></li>
      </ul>
    </nav>
    <div   style="margin-left:auto;color:var(--muted);font-size:13px">status: <strong style="color:var(--green);margin-left:8px"></strong></div>
    <div class="status-container" id="statusContainer">
  <div class="status-text" id="statusText">Offline</div>
</div>
  </header>

  <section class="hero" id="home" role="region" aria-label="Introduction">
