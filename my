      <div class="quicklinks" role="navigation" aria-label="Quick links">
        <a class="btn" href="#projects">Class 12th</a>
        <a class="btn" href="#contact">get in touch</a>
        <a class="btn" href="mailto:you@example.com">email</a>
      </div>
    </div>

    <aside class="hero-right">
      <div class="card" aria-label="Profile card">
        <div class="avatar" aria-hidden="true">YOU</div>
        <div style="display:flex;flex-direction:column;gap:8px">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <div>
              <div style="font-weight:700;color:#eafff0">Harsh Manda</div>
              <div style="font-size:13px;color:var(--muted)">Full stack • security</div>
            </div>
            <div style="text-align:right">
